                </a>

                <div class="reviews-box">
                    <div class="reviews-title">Mijozlar fikri (Otzivlar)</div>
                    <div id="reviewList" class="review-list"></div>
                    
                    <div class="review-form">
                        <input type="text" id="reviewerName" placeholder="Ismingizni yozing...">
                        <textarea id="reviewerText" rows="2" placeholder="Kiyim sifati haqida otziv qoldiring..."></textarea>
                        <button class="review-submit" onclick="addReview()">Otziv qoldirish</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        const TELEGRAM_USERNAME = "medium_admin"; 

        const products = [];
        for (let i = 1; i <= 60; i++) {
            products.push({
                id: i,
                title: `MEDIUM Kolleksiya #${i}`,
                price: `${(250 + (i % 10) * 35)} 000 so'm`,
                img: `rasm${i}.jpg`,
                modelImg: `model${i}.jpg`,
                desc: "Yuqori sifatli mato, zamonaviy fason. Barcha o'lchamlar (S, M, L, XL, XXL) mavjud."
            });
        }

        const catalogEl = document.getElementById("catalog");
        products.forEach((item, index) => {
            const card = document.createElement("div");
            card.className = "card";
            card.onclick = () => openModal(index);

            card.innerHTML = `
                <img src="${item.img}" alt="${item.title}" onerror="this.src='https://via.placeholder.com/300x380/2e211b/e6ccb2?text=Rasm+${item.id}'">
                <div class="card-info">
                    <div class="product-title">${item.title}</div>
                    <div class="product-price">${item.price}</div>
                </div>
            `;
            catalogEl.appendChild(card);
        });

        let currentProductId = null;

        function openModal(index) {
            const item = products[index];
            currentProductId = item.id;

            const modalImg = document.getElementById("modalImg");
            modalImg.src = item.modelImg;
            modalImg.onerror = function() {
                this.src = item.img;
                this.onerror = function() {
                    this.src = `https://via.placeholder.com/400x500/2e211b/e6ccb2?text=Model+${item.id}`;
                };
            };

            document.getElementById("modalTitle").innerText = item.title;
            document.getElementById("modalPrice").innerText = item.price;
            document.getElementById("modalDesc").innerText = item.desc;

            const message = encodeURIComponent(`Assalomu alaykum! Men MEDIUM do'konidan "${item.title}" (${item.price}) buyurtma bermoqchi edim.`);
            document.getElementById("telegramLink").href = `https://t.me/${TELEGRAM_USERNAME}?text=${message}`;

            loadReviews(item.id);
            document.getElementById("productModal").style.display = "block";
        }

        function closeModal() {
            document.getElementById("productModal").style.display = "none";
        }

        function loadReviews(productId) {
            const listEl = document.getElementById("reviewList");
            const saved = JSON.parse(localStorage.getItem("reviews_" + productId)) || [
                { name: "Jasur", text: "Sifati zo'r ekan, razmeri to'g'ri keldi!" }
            ];

            listEl.innerHTML = "";
            saved.forEach(rev => {
                const div = document.createElement("div");
                div.className = "review-item";
                div.innerHTML = `<div class="review-author">${rev.name}</div><div>${rev.text}</div>`;
                listEl.appendChild(div);
            });
        }

        function addReview() {
            const nameInput = document.getElementById("reviewerName");
            const textInput = document.getElementById("reviewerText");

            if (!nameInput.value.trim() || !textInput.value.trim()) {
                alert("Iltimos, ismingiz va fikringizni yozing!");
                return;
            }

            const saved = JSON.parse(localStorage.getItem("reviews_" + currentProductId)) || [
                { name: "Jasur", text: "Sifati zo'r ekan, razmeri to'g'ri keldi!" }
            ];

            saved.push({ name: nameInput.value.trim(), text: textInput.value.trim() });
            localStorage.setItem("reviews_" + current_product_id = null, JSON.stringify(saved)); // fix
            localStorage.setItem("reviews_" + currentProductId, JSON.stringify(saved));

            nameInput.value = "";
            textInput.value = "";
            loadReviews(currentProductId);
        }

        window.onclick = function(event) {
            const modal = document.getElementById("productModal");
            if (event.target === modal) {
                closeModal();
            }
        }
    </script>

</body>
</html>
