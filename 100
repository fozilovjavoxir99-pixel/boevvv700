                    <svg class="insta-icon" viewBox="0 0 24 24" fill="url(#instaGrad)"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
                    <span>@mediumsamarqand</span>
                </a>
            </div>

        </div>
    </footer>

    <!-- MODAL OYNA -->
    <div id="productModal" class="modal">
        <div class="modal-content">
            <span class="close-btn" onclick="closeModal()">&times;</span>
            <img id="modalImg" src="" alt="Model" class="modal-model-img">
            
            <div class="modal-body">
                <div id="modalTitle" class="modal-title"></div>
                <div id="modalPrice" class="modal-price"></div>
                <div id="modalDesc" class="modal-desc"></div>

                <a id="telegramLink" href="#" target="_blank" class="telegram-btn">
                    ✈️ Telegram orqali buyurtma berish
                </a>

                <div class="reviews-box">
                    <div class="reviews-title">Mijozlar fikri (Otzivlar)</div>
                    <div id="reviewList" class="review-list"></div>
                    
                    <div class="review-form">
                        <input type="text" id="reviewerName" placeholder="Ismingiz...">
                        <textarea id="reviewerText" rows="2" placeholder="Fikringizni qoldiring..."></textarea>
                        <button class="review-submit" onclick="addReview()">Otziv qoldirish</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- MAHSULOT QO'SHISH / TAHRIRLASH MODALI (ADMIN UCHUN) -->
    <div id="adminModal" class="modal">
        <div class="modal-content" style="padding: 20px;">
            <span class="close-btn" onclick="closeAdminModal()">&times;</span>
            <h3 style="color:#d4a373; margin-bottom:15px;">Yangi mahsulot qo'shish</h3>
            <div class="review-form">
                <input type="text" id="newTitle" placeholder="Mahsulot nomi (masalan: Kurtka)">
                <input type="text" id="newPrice" placeholder="Narxi (masalan: 350 000 so'm)">
                <input type="text" id="newImg" placeholder="Katalog rasm nomi (masalan: rasm61.jpg)">
                <input type="text" id="newModelImg" placeholder="Model rasm nomi (masalan: model61.jpg)">
                <button class="review-submit" onclick="saveNewProduct()">Qo'shish</button>
            </div>
        </div>
    </div>

    <script>
        const TELEGRAM_USERNAME = "medium_admin"; 

        // Standart 60 ta mahsulot bazasi (yoki localStorage'dan olinadi)
        let products = JSON.parse(localStorage.getItem("custom_products")) || [];
        if (products.length === 0) {
            for (let i = 1; i <= 60; i++) {
                products.push({
                    id: i,
                    title: `MEDIUM Kolleksiya #${i}`,
                    price: `${(250 + (i % 10) * 35)} 000 so'm`,
                    img: `rasm${i}.jpg`,
                    modelImg: `model${i}.jpg`,
                    desc: "Yuqori sifatli mato, zamonaviy fason. Barcha o'lchamlar (S, M, L, XL, XXL) mavjud."
                });
            }
        }

        function renderCatalog() {
            const catalogEl = document.getElementById("catalog");
            catalogEl.innerHTML = "";
            products.forEach((item, index) => {
                const card = document.createElement("div");
                card.className = "card";
                card.onclick = () => openModal(index);

                card.innerHTML = `
                    <img src="${item.img}" alt="${item.title}" onerror="this.src='https://via.placeholder.com/300x380/2e211b/e6ccb2?text=Rasm+${item.id}'">
                    <div class="card-info">
                        <div class="product-title">${item.title}</div>
                        <div class="product-price">${item.price}</div>
                    </div>
                `;
                catalogEl.appendChild(card);
            });
        }
        renderCatalog();

        let currentProductId = null;
        function openModal(index) {
            const item = products[index];
            currentProductId = item.id;

            const modalImg = document.getElementById("modalImg");
            modalImg.src = item.modelImg;
            modalImg.onerror = function() {
                this.src = item.img;
            };

            document.getElementById("modalTitle").innerText = item.title;
            document.getElementById("modalPrice").innerText = item.price;
            document.getElementById("modalDesc").innerText = item.desc;

            const message = encodeURIComponent(`Assalomu alaykum! Men MEDIUM do'konidan "${item.title}" (${item.price}) buyurtma bermoqchi edim.`);
            document.getElementById("telegramLink").href = `https://t.me/${TELEGRAM_USERNAME}?text=${message}`;

            loadReviews(item.id);
            document.getElementById("productModal").style.display = "block";
        }

        function closeModal() {
            document.getElementById("productModal").style.display = "none";
        }

        // ADMIN HUQUQI VA SOZLAMALARI
        function toggleAdmin() {
            let pass = prompt("Admin parolini kiriting:");
            if (pass === "medium2026") { // Parolni xohlasangiz o'zgartirishingiz mumkin
                document.getElementById("addProductBtn").style.display = "block";
                alert("Admin huquqi berildi! Endi mahsulot qo'shishingiz mumkin.");
            } else if (pass !== null) {
                alert("Parol noto'g'ri!");
            }
        }

        function openAddModal() {
            document.getElementById("adminModal").style.display = "block";
        }
        function closeAdminModal() {
            document.getElementById("adminModal").style.display = "none";
        }

        function saveNewProduct() {
            let title = document.getElementById("newTitle").value;
            let price = document.getElementById("newPrice").value;
            let img = document.getElementById("newImg").value;
            let modelImg = document.getElementById("newModelImg").value;

            if(!title || !price) {
                alert("Mahsulot nomi va narxini kiriting!");
                return;
            }

            products.unshift({
                id: products.length + 1,
                title: title,
                price: price,
                img: img || "rasm1.jpg",
                modelImg: modelImg || "model1.jpg",
                desc: "Yuqori sifatli mato, zamonaviy fason. Barcha o'lchamlar mavjud."
            });

            localStorage.setItem("custom_products", JSON.stringify(products));
            renderCatalog();
            closeAdminModal();
            alert("Yangi mahsulot muvaffaqiyatli qo'shildi!");
        }

        function loadReviews(productId) {
            const listEl = document.getElementById("reviewList");
            const saved = JSON.parse(localStorage.getItem("reviews_" + productId)) || [
                { name: "Jasur", text: "Sifati zo'r ekan, razmeri to'g'ri keldi!" }
            ];

            listEl.innerHTML = "";
            saved.forEach(rev => {
                const div = document.createElement("div");
                div.className = "review-item";
                div.innerHTML = `<div class="review-author">${rev.name}</div><div>${rev.text}</div>`;
                listEl.appendChild(div);
            });
        }

        function addReview() {
            const nameInput = document.getElementById("reviewerName");
            const textInput = document.getElementById("reviewerText");

            if (!nameInput.value.trim() || !textInput.value.trim()) {
                alert("Iltimos, ismingiz va fikringizni yozing!");
                return;
            }

            const saved = JSON.parse(localStorage.getItem("reviews_" + currentProductId)) || [
                { name: "Jasur", text: "Sifati zo'r ekan, razmeri to'g'ri keldi!" }
            ];

            saved.push({ name: nameInput.value.trim(), text: textInput.value.trim() });
            localStorage.setItem("reviews_" + currentProductId, JSON.stringify(saved));

            nameInput.value = "";
            textInput.value = "";
            loadReviews(currentProductId);
        }

        window.onclick = function(event) {
            if (event.target === document.getElementById("productModal")) closeModal();
            if (event.target === document.getElementById("adminModal")) closeAdminModal();
        }
    </script>
</body>
</html>
