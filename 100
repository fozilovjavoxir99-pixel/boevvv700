    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MEDIUM — Premium Men's Fashion Store</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        }

        /* To'q jigarrang fon va kreativ chiziqli dizayn */
        body {
            background-color: #160f0c;
            background-image: 
                radial-gradient(circle at 15% 15%, rgba(212, 163, 115, 0.09) 0%, transparent 45%),
                radial-gradient(circle at 85% 85%, rgba(212, 163, 115, 0.07) 0%, transparent 45%),
                linear-gradient(135deg, rgba(255, 255, 255, 0.015) 25%, transparent 25%),
                linear-gradient(225deg, rgba(255, 255, 255, 0.015) 25%, transparent 25%);
            background-size: 100% 100%, 100% 100%, 50px 50px, 50px 50px;
            color: #ffffff;
            line-height: 1.5;
        }

        /* 1. YUQORI QISM: LOGO VA XUSH KELIBSIZ */
        header {
            text-align: center;
            padding: 30px 15px;
            background: linear-gradient(180deg, #261b16 0%, #160f0c 100%);
            border-bottom: 2px solid #3d2c24;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
            position: relative;
        }

        .admin-login-icon {
            position: absolute;
            top: 15px;
            right: 15px;
            background: #2b1f19;
            color: #d4a373;
            border: 1px solid #4a352b;
            padding: 6px 12px;
            border-radius: 8px;
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
        }

        .logo-img {
            width: 95px;
            height: 95px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid #d4a373;
            margin-bottom: 12px;
            background-color: #3d2c24;
            box-shadow: 0 0 15px rgba(212, 163, 115, 0.3);
        }

        .brand-name { MEDIUM MENS WEAR
            font-size: 30px;
            font-weight: 800;
            letter-spacing: 3px;
            color: #ffffff;
            margin-bottom: 6px;
        }

        .welcome-text { MEDIUM ERKAKLAR DOKONIGA HUSH KELIBSIZ 
                Добро пожаловать в магазин мужской одежды MEDIUM
                                 Welcome to MEDIUM Men's Clothing Store
            font-size: 15px;
            color: #e6ccb2;
            max-width: 350px;
            margin: 0 auto;
            font-weight: 500;
        }

        /* 2. KATALOG QISMI */
        .container {
            padding: 20px 14px;
            max-width: 820px;
            margin: 0 auto;
        }

        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 16px;
        }

        .section-title {
            font-size: 17px;
            font-weight: 700;
            color: #e6ccb2;
            padding-left: 10px;
            border-left: 4px solid #d4a373;
        }

        .add-product-btn {
            background-color: #d4a373;
            color: #160f0c;
            border: none;
            padding: 6px 12px;
            border-radius: 8px;
            font-weight: 700;
            font-size: 12px;
            cursor: pointer;
            display: none; /* Faqat admin kirganda chiqadi */
        }

        .products-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 14px;
        }

        .card {
            background: rgba(38, 27, 22, 0.9);
            border-radius: 14px;
            overflow: hidden;
            border: 1px solid #4a352b;
            display: flex;
            flex-direction: column;
            cursor: pointer;
            transition: transform 0.2s, border-color 0.2s;
            box-shadow: 0 4px 10px rgba(0,0,0,0.3);
        }

        .card:active {
            transform: scale(0.97);
            border-color: #d4a373;
        }

        .card img {
            width: 100%;
            height: 200px;
            object-fit: cover;
            background-color: #33251e;
            display: block;
        }

        .card-info {
            padding: 12px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            flex-grow: 1;
        }

        .product-title {
            font-size: 14px;
            font-weight: 600;
            color: #ffffff;
            margin-bottom: 8px;
        }

        .product-price {
            font-size: 14px;
            font-weight: 700;
            color: #160f0c;
            background: linear-gradient(135deg, #f3e5d8 0%, #d4a373 100%);
            padding: 6px 10px;
            border-radius: 8px;
            align-self: flex-start;
        }

        /* 3. ENG PASTKI QISM: KONTAKTLAR, LOKATSIYALAR VA INSTAGRAM */
        footer {+998944487181
            margin-top: 40px;
            padding: 35px 16px 50px 16px;
            background: linear-gradient(180deg, #160f0c 0%, #0d0907 100%);
            border-top: 2px solid #3d2c24;
        }

        .footer-wrapper {
            max-width: 500px;
            margin: 0 auto;
        }

        .footer-heading {
            font-size: 16px;
            font-weight: 700;
            color: #d4a373;
            margin-bottom: 14px;
            text-align: center;
            letter-spacing: 0.5px;
        }

        .links-group {
            display: flex;
            flex-direction: column;
            gap: 10px;
            margin-bottom: 30px;
        }

        .contact-btn, .location-btn, .insta-btn {
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
            padding: 14px 16px;
            border-radius: 12px;
            font-weight: 600;
            font-size: 14px;
            color: #ffffff;
            background: rgba(38, 27, 22, 0.9);
            border: 1px solid #4a352b;
            transition: all 0.2s;
        }

        .contact-btn {
            background: linear-gradient(135deg, #1e3a2f 0%, #142820 100%);
            border-color: #2e5a46;
        }

        .insta-btn {
            background: linear-gradient(135deg, rgba(43, 31, 25, 0.9) 0%, rgba(60, 38, 33, 0.9) 100%);
        }

        .insta-icon, .contact-icon {
            width: 22px;
            height: 22px;
            flex-shrink: 0;
        }

        /* 4. MODAL OYNA */
        .modal {
            display: none;
            position: fixed;
            z-index: 1000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.88);
            backdrop-filter: blur(5px);
            overflow-y: auto;
            padding: 15px;
        }

        .modal-content {
            background-color: #261b16;
            margin: 20px auto 40px auto;
            border-radius: 16px;
            max-width: 480px;
            border: 1px solid #d4a373;
            overflow: hidden;
            position: relative;
            box-shadow: 0 10px 25px rgba(0,0,0,0.5);
        }

        .close-btn {
            position: absolute;
            top: 12px;
            right: 12px;
            background-color: rgba(28, 20, 16, 0.85);
            color: #ffffff;
            width: 36px;
            height: 36px;
            border-radius: 50%;
            text-align: center;
            line-height: 36px;
            font-size: 22px;
            font-weight: bold;
            cursor: pointer;
            border: 1px solid #d4a373;
            z-index: 10;
        }

        .modal-model-img {
            width: 100%;
            max-height: 450px;
            object-fit: cover;
            background-color: #33251e;
            display: block;
        }

        .modal-body {
            padding: 20px;
        }

        .modal-title {
            font-size: 20px;
            font-weight: 700;
            margin-bottom: 6px;
            color: #ffffff;
        }

        .modal-price {
            font-size: 18px;
            font-weight: 700;
            color: #d4a373;
            margin-bottom: 10px;
        }

        .modal-desc {
            font-size: 14px;
            color: #e6ccb2;
            margin-bottom: 18px;
        }

        .telegram-btn { @Mediium_uz
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            width: 100%;
            background: linear-gradient(135deg, #24A1DE 0%, #1d85bc 100%);
            color: #ffffff;
            text-decoration: none;
            padding: 14px;
            border-radius: 12px;
            font-weight: 700;
            font-size: 15px;
            margin-bottom: 22px;
