        /* Otziv bo'limi */
        .reviews-box {
            border-top: 1px solid #3d2c24;
            padding-top: 16px;
        }

        .reviews-title {
            font-size: 15px;
            font-weight: 700;
            margin-bottom: 10px;
            color: #e6ccb2;
        }

        .review-list {
            max-height: 160px;
            overflow-y: auto;
            margin-bottom: 12px;
        }

        .review-item {
            background-color: #160f0c;
            padding: 10px 12px;
            border-radius: 10px;
            margin-bottom: 8px;
            font-size: 13px;
            border: 1px solid #33251e;
        }

        .review-author {
            font-weight: 700;
            color: #d4a373;
            font-size: 12px;
            margin-bottom: 2px;
        }

        .review-form input, .review-form textarea {
            width: 100%;
            padding: 11px;
            margin-bottom: 8px;
            border-radius: 10px;
            border: 1px solid #4a352b;
            background-color: #160f0c;
            color: #ffffff;
            font-size: 13px;
        }

        .review-submit {
            width: 100%;
            padding: 11px;
            background: linear-gradient(135deg, #d4a373 0%, #bc8a59 100%);
            color: #160f0c;
            font-weight: 700;
            border: none;
            border-radius: 10px;
            cursor: pointer;
            font-size: 14px;
        }
    </style>
